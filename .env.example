# Copy to .env.local (never commit it).

# Where the app sends AI estimates. In dev, the Vite server answers /api/estimate itself.
# After deploying the Supabase Edge Function, point this at
# https://<project-ref>.supabase.co/functions/v1/estimate
VITE_ESTIMATE_URL=/api/estimate

# Server-side only (read by the Vite dev server; never sent to the browser).
# Without it, the app uses the offline catalogue estimator.
ANTHROPIC_API_KEY=
